generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  PROFESSOR
  KINESIOLOGIST
  OSTEOPATH
  ADMINISTRATIVE
  GENERAL_ADMIN
  BROCO_SUPPORT
}

enum InternalUserStatus {
  ACTIVE
  INACTIVE
}

model InternalUser {
  id              String             @id @default(uuid()) @db.Uuid
  firstName       String             @map("first_name")
  lastName        String             @map("last_name")
  email           String
  normalizedEmail String             @unique @map("normalized_email")
  status          InternalUserStatus @default(ACTIVE)
  createdAt       DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  roles           InternalUserRole[]
  credential      InternalCredential?
  sessions        Session[]
  salaParticipations SalaParticipation[]

  @@map("internal_users")
}

model InternalUserRole {
  internalUserId String       @map("internal_user_id") @db.Uuid
  role           Role
  internalUser   InternalUser @relation(fields: [internalUserId], references: [id], onDelete: Restrict)

  @@id([internalUserId, role])
  @@map("internal_user_roles")
}

enum SessionKind {
  INTERNAL
  PORTAL
}

enum SalaWeekday {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}
enum SalaScheduleExceptionType {
  CLOSURE
  CAPACITY_OVERRIDE
}

model InternalCredential {
  internalUserId       String       @id @map("internal_user_id") @db.Uuid
  passwordHash         String       @map("password_hash")
  mustChangePassword   Boolean      @default(true) @map("must_change_password")
  credentialsUpdatedAt DateTime     @default(now()) @map("credentials_updated_at") @db.Timestamptz(6)
  internalUser         InternalUser @relation(fields: [internalUserId], references: [id], onDelete: Cascade)
  @@map("internal_credentials")
}

model Session {
  id             String        @id @default(uuid()) @db.Uuid
  kind           SessionKind
  internalUserId String?       @map("internal_user_id") @db.Uuid
  personId       String?       @map("person_id") @db.Uuid
  secretHash     String        @unique @map("secret_hash")
  csrfToken      String        @map("csrf_token")
  expiresAt      DateTime      @map("expires_at") @db.Timestamptz(6)
  lastActivityAt DateTime      @default(now()) @map("last_activity_at") @db.Timestamptz(6)
  revokedAt      DateTime?     @map("revoked_at") @db.Timestamptz(6)
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  internalUser   InternalUser? @relation(fields: [internalUserId], references: [id], onDelete: Cascade)
  person         Person?       @relation(fields: [personId], references: [id], onDelete: Cascade)
  @@index([internalUserId])
  @@index([personId])
  @@index([expiresAt])
  @@index([revokedAt])
  @@map("sessions")
}

model AuthAttemptBucket {
  key             String    @id
  failureCount    Int       @default(0) @map("failure_count")
  windowStartedAt DateTime  @map("window_started_at") @db.Timestamptz(6)
  lockedUntil     DateTime? @map("locked_until") @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("auth_attempt_buckets")
}

model Person {
  id                    String   @id @default(uuid()) @db.Uuid
  firstName             String   @map("first_name")
  lastName              String   @map("last_name")
  dni                   String
  normalizedDni         String   @unique @map("normalized_dni")
  phone                 String
  birthDate             DateTime @map("birth_date") @db.Date
  email                 String?
  normalizedEmail       String?  @map("normalized_email")
  emergencyContactName  String?  @map("emergency_contact_name")
  emergencyContactPhone String?  @map("emergency_contact_phone")
  socialWorkId          String?  @map("social_work_id") @db.Uuid
  affiliateNumber       String?  @map("affiliate_number")
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  portalCredential      PortalCredential?
  portalSessions        Session[]
  salaParticipations    SalaParticipation[]
  fixedBookings         FixedSalaBooking[]
  reservations          OneOffReservation[]

  @@index([lastName, firstName])
  @@index([normalizedEmail])
  @@map("people")
}

model SalaConfiguration {
  id              String   @id @default("default")
  generalCapacity Int      @map("general_capacity")
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  @@map("sala_configuration")
}

model SalaPlan {
  id            String   @id @default(uuid()) @db.Uuid
  name          String
  monthlyAmount Decimal  @map("monthly_amount") @db.Decimal(14, 0)
  isSelectable  Boolean  @default(true) @map("is_selectable")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  participations SalaParticipation[]
  @@map("sala_plans")
}

model SalaParticipation {
  id               String       @id @default(uuid()) @db.Uuid
  personId         String       @map("person_id") @db.Uuid
  mainProfessorId  String       @map("main_professor_id") @db.Uuid
  planId           String       @map("plan_id") @db.Uuid
  startDate        DateTime     @map("start_date") @db.Date
  endDate          DateTime?    @map("end_date") @db.Date
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  person           Person       @relation(fields: [personId], references: [id], onDelete: Restrict)
  mainProfessor    InternalUser @relation(fields: [mainProfessorId], references: [id], onDelete: Restrict)
  plan             SalaPlan     @relation(fields: [planId], references: [id], onDelete: Restrict)
  fixedBookings    FixedSalaBooking[]
  reservations     OneOffReservation[]
  @@index([personId])
  @@index([mainProfessorId])
  @@index([planId])
  @@map("sala_participations")
}

model SalaScheduleSlot {
  id              String            @id @default(uuid()) @db.Uuid
  weekday         SalaWeekday
  startTime       DateTime          @map("start_time") @db.Time(0)
  durationMinutes Int               @default(60) @map("duration_minutes")
  specificCapacity Int?             @map("specific_capacity")
  isActive        Boolean           @default(true) @map("is_active")
  endedAt         DateTime?         @map("ended_at") @db.Date
  createdAt       DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  exceptions      SalaScheduleException[]
  fixedBookings   FixedSalaBooking[]
  reservations    OneOffReservation[]
  @@unique([weekday, startTime])
  @@map("sala_schedule_slots")
}

model FixedSalaBooking {
  id                  String   @id @default(uuid()) @db.Uuid
  personId            String   @map("person_id") @db.Uuid
  salaParticipationId String   @map("sala_participation_id") @db.Uuid
  scheduleSlotId      String   @map("schedule_slot_id") @db.Uuid
  startDate           DateTime @map("start_date") @db.Date
  endDate             DateTime? @map("end_date") @db.Date
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  person              Person @relation(fields: [personId], references: [id], onDelete: Restrict)
  salaParticipation  SalaParticipation @relation(fields: [salaParticipationId], references: [id], onDelete: Restrict)
  scheduleSlot        SalaScheduleSlot @relation(fields: [scheduleSlotId], references: [id], onDelete: Restrict)
  @@index([personId])
  @@index([salaParticipationId])
  @@index([scheduleSlotId])
  @@map("fixed_sala_bookings")
}

model OneOffReservation {
  id                  String   @id @default(uuid()) @db.Uuid
  personId            String   @map("person_id") @db.Uuid
  salaParticipationId String   @map("sala_participation_id") @db.Uuid
  scheduleSlotId      String   @map("schedule_slot_id") @db.Uuid
  date                DateTime @db.Date
  cancelledAt         DateTime? @map("cancelled_at") @db.Timestamptz(6)
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  person              Person @relation(fields: [personId], references: [id], onDelete: Restrict)
  salaParticipation  SalaParticipation @relation(fields: [salaParticipationId], references: [id], onDelete: Restrict)
  scheduleSlot        SalaScheduleSlot @relation(fields: [scheduleSlotId], references: [id], onDelete: Restrict)
  @@unique([personId, scheduleSlotId, date])
  @@index([date, scheduleSlotId])
  @@map("one_off_reservations")
}

model SalaScheduleException {
  id              String                    @id @default(uuid()) @db.Uuid
  scheduleSlotId  String                    @map("schedule_slot_id") @db.Uuid
  date            DateTime                  @db.Date
  type            SalaScheduleExceptionType
  capacityOverride Int?                     @map("capacity_override")
  scheduleSlot    SalaScheduleSlot          @relation(fields: [scheduleSlotId], references: [id], onDelete: Cascade)
  @@unique([scheduleSlotId, date])
  @@map("sala_schedule_exceptions")
}

model PortalCredential {
  personId             String   @id @map("person_id") @db.Uuid
  pinHash              String   @map("pin_hash")
  mustChangePin        Boolean  @default(true) @map("must_change_pin")
  credentialsUpdatedAt DateTime @default(now()) @map("credentials_updated_at") @db.Timestamptz(6)
  person               Person   @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@map("portal_credentials")
}
