generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  PROFESSOR
  KINESIOLOGIST
  OSTEOPATH
  ADMINISTRATIVE
  GENERAL_ADMIN
  BROCO_SUPPORT
}

enum InternalUserStatus {
  ACTIVE
  INACTIVE
}

model InternalUser {
  id              String             @id @default(uuid()) @db.Uuid
  firstName       String             @map("first_name")
  lastName        String             @map("last_name")
  email           String
  normalizedEmail String             @unique @map("normalized_email")
  status          InternalUserStatus @default(ACTIVE)
  createdAt       DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  roles           InternalUserRole[]
  credential      InternalCredential?
  sessions        Session[]
  salaParticipations SalaParticipation[]
  createdSalaOccurrences  SalaOccurrence[] @relation("SalaOccurrenceCreatedBy")
  modifiedSalaOccurrences SalaOccurrence[] @relation("SalaOccurrenceModifiedBy")
  physicalEvaluationsAsProfessor PhysicalEvaluation[] @relation("PhysicalEvaluationProfessor")
  createdPhysicalEvaluations PhysicalEvaluation[] @relation("PhysicalEvaluationCreatedBy")
  salaPaymentsRegistered SalaPayment[]
  salaPaymentsModified SalaPayment[] @relation("SalaPaymentModifiedBy")
  clinicalAppointments ClinicalAppointment[] @relation("ClinicalAppointmentProfessional")
  registeredPatients ClinicalPatient[]
  clinicalAttentions ClinicalAttention[]
  treatments Treatment[]
  evolutionsAuthored Evolution[] @relation("EvolutionAuthor")
  evolutionsModified Evolution[] @relation("EvolutionModifier")

  @@map("internal_users")
}

model InternalUserRole {
  internalUserId String       @map("internal_user_id") @db.Uuid
  role           Role
  internalUser   InternalUser @relation(fields: [internalUserId], references: [id], onDelete: Restrict)

  @@id([internalUserId, role])
  @@map("internal_user_roles")
}

enum SessionKind {
  INTERNAL
  PORTAL
}

enum SalaWeekday {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}
enum SalaScheduleExceptionType {
  CLOSURE
  CAPACITY_OVERRIDE
}
enum SalaOccurrenceOrigin {
  FIXED
  ONE_OFF
  SPONTANEOUS
}
enum SalaOccurrenceStatus {
  RESERVED
  ATTENDED
  CANCELLED
  ABSENT
}
enum ClinicalAppointmentStatus {
  SCHEDULED
  ATTENDED
  CANCELLED
  ABSENT
}
enum RoutineStatus {
  ACTIVE
  HISTORICAL
}

model InternalCredential {
  internalUserId       String       @id @map("internal_user_id") @db.Uuid
  passwordHash         String       @map("password_hash")
  mustChangePassword   Boolean      @default(true) @map("must_change_password")
  credentialsUpdatedAt DateTime     @default(now()) @map("credentials_updated_at") @db.Timestamptz(6)
  internalUser         InternalUser @relation(fields: [internalUserId], references: [id], onDelete: Cascade)
  @@map("internal_credentials")
}

model Session {
  id             String        @id @default(uuid()) @db.Uuid
  kind           SessionKind
  internalUserId String?       @map("internal_user_id") @db.Uuid
  personId       String?       @map("person_id") @db.Uuid
  secretHash     String        @unique @map("secret_hash")
  csrfToken      String        @map("csrf_token")
  expiresAt      DateTime      @map("expires_at") @db.Timestamptz(6)
  lastActivityAt DateTime      @default(now()) @map("last_activity_at") @db.Timestamptz(6)
  revokedAt      DateTime?     @map("revoked_at") @db.Timestamptz(6)
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  internalUser   InternalUser? @relation(fields: [internalUserId], references: [id], onDelete: Cascade)
  person         Person?       @relation(fields: [personId], references: [id], onDelete: Cascade)
  @@index([internalUserId])
  @@index([personId])
  @@index([expiresAt])
  @@index([revokedAt])
  @@map("sessions")
}

model AuthAttemptBucket {
  key             String    @id
  failureCount    Int       @default(0) @map("failure_count")
  windowStartedAt DateTime  @map("window_started_at") @db.Timestamptz(6)
  lockedUntil     DateTime? @map("locked_until") @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("auth_attempt_buckets")
}

model Person {
  id                    String   @id @default(uuid()) @db.Uuid
  firstName             String   @map("first_name")
  lastName              String   @map("last_name")
  dni                   String
  normalizedDni         String   @unique @map("normalized_dni")
  phone                 String
  birthDate             DateTime @map("birth_date") @db.Date
  email                 String?
  normalizedEmail       String?  @map("normalized_email")
  emergencyContactName  String?  @map("emergency_contact_name")
  emergencyContactPhone String?  @map("emergency_contact_phone")
  socialWorkId          String?  @map("social_work_id") @db.Uuid
  affiliateNumber       String?  @map("affiliate_number")
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  portalCredential      PortalCredential?
  portalSessions        Session[]
  salaParticipations    SalaParticipation[]
  fixedBookings         FixedSalaBooking[]
  reservations          OneOffReservation[]
  salaOccurrences       SalaOccurrence[]
  routines              Routine[]
  physicalEvaluations   PhysicalEvaluation[]
  salaPayments           SalaPayment[]
  clinicalPatient ClinicalPatient?
  clinicalAppointments ClinicalAppointment[]
  clinicalAttentions ClinicalAttention[]
  treatments Treatment[]

  @@index([lastName, firstName])
  @@index([normalizedEmail])
  @@map("people")
}

model ClinicalPatient {
  personId String @id @map("person_id") @db.Uuid
  registeredById String @map("registered_by_id") @db.Uuid
  registeredAt DateTime @default(now()) @map("registered_at") @db.Timestamptz(6)
  person Person @relation(fields: [personId], references: [id], onDelete: Restrict)
  registeredBy InternalUser @relation(fields: [registeredById], references: [id], onDelete: Restrict)
  @@map("clinical_patients")
}

model ClinicalAppointment {
  id String @id @default(uuid()) @db.Uuid
  personId String @map("person_id") @db.Uuid
  professionalId String @map("professional_id") @db.Uuid
  startAt DateTime @map("start_at") @db.Timestamptz(6)
  durationMinutes Int @default(60) @map("duration_minutes")
  status ClinicalAppointmentStatus @default(SCHEDULED)
  operationalNote String? @map("operational_note")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  person Person @relation(fields: [personId], references: [id], onDelete: Restrict)
  professional InternalUser @relation("ClinicalAppointmentProfessional", fields: [professionalId], references: [id], onDelete: Restrict)
  attention ClinicalAttention?
  @@index([personId, startAt])
  @@index([professionalId, startAt])
  @@index([status, startAt])
  @@map("clinical_appointments")
}

model ClinicalAttention {
  id String @id @default(uuid()) @db.Uuid
  appointmentId String @unique @map("appointment_id") @db.Uuid
  personId String @map("person_id") @db.Uuid
  professionalId String @map("professional_id") @db.Uuid
  occurredAt DateTime @map("occurred_at") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  appointment ClinicalAppointment @relation(fields:[appointmentId],references:[id],onDelete:Restrict)
  person Person @relation(fields:[personId],references:[id],onDelete:Restrict)
  professional InternalUser @relation(fields:[professionalId],references:[id],onDelete:Restrict)
  treatmentId String? @map("treatment_id") @db.Uuid
  treatment Treatment? @relation(fields:[treatmentId],references:[id],onDelete:Restrict)
  evolution Evolution?
  @@map("clinical_attentions")
}

model Evolution {
  id String @id @default(uuid()) @db.Uuid
  attentionId String @unique @map("attention_id") @db.Uuid
  evolutionText String? @map("evolution_text")
  practicesOrManeuvers String? @map("practices_or_maneuvers")
  indicationsOrNextSteps String? @map("indications_or_next_steps")
  authorId String @map("author_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  lastModifiedById String? @map("last_modified_by_id") @db.Uuid
  lastModifiedAt DateTime? @map("last_modified_at") @db.Timestamptz(6)
  attention ClinicalAttention @relation(fields:[attentionId],references:[id],onDelete:Restrict)
  author InternalUser @relation("EvolutionAuthor",fields:[authorId],references:[id],onDelete:Restrict)
  lastModifiedBy InternalUser? @relation("EvolutionModifier",fields:[lastModifiedById],references:[id],onDelete:Restrict)
  @@map("clinical_evolutions")
}

enum TreatmentStatus {
  IN_PROGRESS
  FINISHED
}
enum TreatmentFinishReason {
  DISCHARGE
  INTERRUPTION
  REFERRAL
  OTHER
}
model Treatment {
  id String @id @default(uuid()) @db.Uuid
  personId String @map("person_id") @db.Uuid
  responsibleProfessionalId String @map("responsible_professional_id") @db.Uuid
  consultationReason String @map("consultation_reason")
  bodyAreaOrInjury String @map("body_area_or_injury")
  objective String?
  interventionPlan String?
  startDate DateTime @map("start_date") @db.Date
  status TreatmentStatus @default(IN_PROGRESS)
  finishDate DateTime? @map("finish_date") @db.Date
  finishReason TreatmentFinishReason? @map("finish_reason")
  conclusion String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  person Person @relation(fields:[personId],references:[id],onDelete:Restrict)
  responsibleProfessional InternalUser @relation(fields:[responsibleProfessionalId],references:[id],onDelete:Restrict)
  attentions ClinicalAttention[]
  @@index([personId,status])
  @@index([responsibleProfessionalId,status])
  @@map("treatments")
}

model SalaConfiguration {
  id              String   @id @default("default")
  generalCapacity Int      @map("general_capacity")
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  @@map("sala_configuration")
}

model SalaPlan {
  id            String   @id @default(uuid()) @db.Uuid
  name          String
  monthlyAmount Decimal  @map("monthly_amount") @db.Decimal(14, 0)
  isSelectable  Boolean  @default(true) @map("is_selectable")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  participations SalaParticipation[]
  @@map("sala_plans")
}

model SalaParticipation {
  id               String       @id @default(uuid()) @db.Uuid
  personId         String       @map("person_id") @db.Uuid
  mainProfessorId  String       @map("main_professor_id") @db.Uuid
  planId           String       @map("plan_id") @db.Uuid
  startDate        DateTime     @map("start_date") @db.Date
  endDate          DateTime?    @map("end_date") @db.Date
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  person           Person       @relation(fields: [personId], references: [id], onDelete: Restrict)
  mainProfessor    InternalUser @relation(fields: [mainProfessorId], references: [id], onDelete: Restrict)
  plan             SalaPlan     @relation(fields: [planId], references: [id], onDelete: Restrict)
  fixedBookings    FixedSalaBooking[]
  reservations     OneOffReservation[]
  routines         Routine[]
  physicalEvaluations PhysicalEvaluation[]
  @@index([personId])
  @@index([mainProfessorId])
  @@index([planId])
  @@map("sala_participations")
}

model ExerciseDefinition {
  id            String            @id @default(uuid()) @db.Uuid
  name          String            @db.VarChar(120)
  primaryMuscle String            @map("primary_muscle") @db.VarChar(120)
  description   String?           @db.VarChar(500)
  isActive      Boolean           @default(true) @map("is_active")
  createdAt     DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  routineExercises RoutineExercise[]

  @@unique([name])
  @@map("exercise_definitions")
}

model Routine {
  id                  String            @id @default(uuid()) @db.Uuid
  personId            String            @map("person_id") @db.Uuid
  salaParticipationId String            @map("sala_participation_id") @db.Uuid
  status              RoutineStatus
  version             Int
  createdAt           DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  person              Person            @relation(fields: [personId], references: [id], onDelete: Restrict)
  salaParticipation   SalaParticipation @relation(fields: [salaParticipationId], references: [id], onDelete: Restrict)
  days                RoutineDay[]

  @@unique([personId, version])
  @@index([salaParticipationId])
  @@map("routines")
}

model RoutineDay {
  id        String            @id @default(uuid()) @db.Uuid
  routineId String            @map("routine_id") @db.Uuid
  position  Int
  name      String?           @db.VarChar(120)
  routine   Routine           @relation(fields: [routineId], references: [id], onDelete: Cascade)
  exercises RoutineExercise[]

  @@unique([routineId, position])
  @@map("routine_days")
}

model RoutineExercise {
  id                   String             @id @default(uuid()) @db.Uuid
  routineDayId         String             @map("routine_day_id") @db.Uuid
  exerciseDefinitionId String             @map("exercise_definition_id") @db.Uuid
  position             Int
  series               String?            @db.VarChar(80)
  repetitions          String?            @db.VarChar(80)
  duration             String?            @db.VarChar(80)
  load                  String?            @db.VarChar(80)
  rest                  String?            @db.VarChar(80)
  notes                 String?            @db.VarChar(500)
  routineDay            RoutineDay         @relation(fields: [routineDayId], references: [id], onDelete: Cascade)
  exerciseDefinition    ExerciseDefinition @relation(fields: [exerciseDefinitionId], references: [id], onDelete: Restrict)

  @@unique([routineDayId, position])
  @@index([exerciseDefinitionId])
  @@map("routine_exercises")
}

model PhysicalTestDefinition {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @db.VarChar(120)
  type        String   @db.VarChar(80)
  description String?  @db.VarChar(500)
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  results     PhysicalTestResult[]
  @@unique([name])
  @@map("physical_test_definitions")
}

model PhysicalEvaluation {
  id                  String              @id @default(uuid()) @db.Uuid
  personId            String              @map("person_id") @db.Uuid
  salaParticipationId String              @map("sala_participation_id") @db.Uuid
  professorId         String              @map("professor_id") @db.Uuid
  evaluationDate      DateTime            @map("evaluation_date") @db.Date
  createdBy           String              @map("created_by") @db.Uuid
  createdAt           DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)
  person              Person              @relation(fields: [personId], references: [id], onDelete: Restrict)
  salaParticipation   SalaParticipation   @relation(fields: [salaParticipationId], references: [id], onDelete: Restrict)
  professor           InternalUser         @relation("PhysicalEvaluationProfessor", fields: [professorId], references: [id], onDelete: Restrict)
  creator             InternalUser         @relation("PhysicalEvaluationCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)
  results             PhysicalTestResult[]
  @@index([personId, evaluationDate])
  @@map("physical_evaluations")
}

model PhysicalTestResult {
  id                  String                @id @default(uuid()) @db.Uuid
  evaluationId        String                @map("evaluation_id") @db.Uuid
  testDefinitionId    String                @map("test_definition_id") @db.Uuid
  resultText          String                @map("result_text") @db.VarChar(500)
  evaluation          PhysicalEvaluation    @relation(fields: [evaluationId], references: [id], onDelete: Cascade)
  testDefinition      PhysicalTestDefinition @relation(fields: [testDefinitionId], references: [id], onDelete: Restrict)
  @@index([testDefinitionId])
  @@map("physical_test_results")
}

model SalaScheduleSlot {
  id              String            @id @default(uuid()) @db.Uuid
  weekday         SalaWeekday
  startTime       DateTime          @map("start_time") @db.Time(0)
  durationMinutes Int               @default(60) @map("duration_minutes")
  specificCapacity Int?             @map("specific_capacity")
  startsAt        DateTime          @default(dbgenerated("'1970-01-01'::date")) @map("starts_at") @db.Date
  isActive        Boolean           @default(true) @map("is_active")
  endedAt         DateTime?         @map("ended_at") @db.Date
  createdAt       DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  exceptions      SalaScheduleException[]
  fixedBookings   FixedSalaBooking[]
  reservations    OneOffReservation[]
  occurrences     SalaOccurrence[]
  @@unique([weekday, startTime])
  @@map("sala_schedule_slots")
}

model FixedSalaBooking {
  id                  String   @id @default(uuid()) @db.Uuid
  personId            String   @map("person_id") @db.Uuid
  salaParticipationId String   @map("sala_participation_id") @db.Uuid
  scheduleSlotId      String   @map("schedule_slot_id") @db.Uuid
  startDate           DateTime @map("start_date") @db.Date
  endDate             DateTime? @map("end_date") @db.Date
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  person              Person @relation(fields: [personId], references: [id], onDelete: Restrict)
  salaParticipation  SalaParticipation @relation(fields: [salaParticipationId], references: [id], onDelete: Restrict)
  scheduleSlot        SalaScheduleSlot @relation(fields: [scheduleSlotId], references: [id], onDelete: Restrict)
  occurrences         SalaOccurrence[]
  @@index([personId])
  @@index([salaParticipationId])
  @@index([scheduleSlotId])
  @@map("fixed_sala_bookings")
}

model OneOffReservation {
  id                  String   @id @default(uuid()) @db.Uuid
  personId            String   @map("person_id") @db.Uuid
  salaParticipationId String   @map("sala_participation_id") @db.Uuid
  scheduleSlotId      String   @map("schedule_slot_id") @db.Uuid
  date                DateTime @db.Date
  cancelledAt         DateTime? @map("cancelled_at") @db.Timestamptz(6)
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  person              Person @relation(fields: [personId], references: [id], onDelete: Restrict)
  salaParticipation  SalaParticipation @relation(fields: [salaParticipationId], references: [id], onDelete: Restrict)
  scheduleSlot        SalaScheduleSlot @relation(fields: [scheduleSlotId], references: [id], onDelete: Restrict)
  occurrences         SalaOccurrence[]
  @@unique([personId, scheduleSlotId, date])
  @@index([date, scheduleSlotId])
  @@map("one_off_reservations")
}

model SalaOccurrence {
  id                  String                @id @default(uuid()) @db.Uuid
  personId            String                @map("person_id") @db.Uuid
  scheduleSlotId      String                @map("schedule_slot_id") @db.Uuid
  date                DateTime              @db.Date
  origin              SalaOccurrenceOrigin
  status              SalaOccurrenceStatus
  fixedSalaBookingId  String?               @map("fixed_sala_booking_id") @db.Uuid
  oneOffReservationId String?               @map("one_off_reservation_id") @db.Uuid
  createdBy           String                @map("created_by") @db.Uuid
  createdAt           DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  lastModifiedAt      DateTime              @updatedAt @map("last_modified_at") @db.Timestamptz(6)
  lastModifiedBy      String                @map("last_modified_by") @db.Uuid
  person              Person                @relation(fields: [personId], references: [id], onDelete: Restrict)
  scheduleSlot        SalaScheduleSlot      @relation(fields: [scheduleSlotId], references: [id], onDelete: Restrict)
  fixedSalaBooking    FixedSalaBooking?     @relation(fields: [fixedSalaBookingId], references: [id], onDelete: Restrict)
  oneOffReservation   OneOffReservation?    @relation(fields: [oneOffReservationId], references: [id], onDelete: Restrict)
  creator             InternalUser          @relation("SalaOccurrenceCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)
  lastModifier        InternalUser          @relation("SalaOccurrenceModifiedBy", fields: [lastModifiedBy], references: [id], onDelete: Restrict)
  @@unique([personId, scheduleSlotId, date])
  @@index([date, scheduleSlotId])
  @@map("sala_occurrences")
}

model PaymentMethod {
  id String @id @default(uuid()) @db.Uuid
  name String
  isSelectable Boolean @default(true) @map("is_selectable")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  salaPayments SalaPayment[]
  @@map("payment_methods")
}

model SalaPayment {
  id String @id @default(uuid()) @db.Uuid
  personId String @map("person_id") @db.Uuid
  year Int
  month Int
  paidAt DateTime @map("paid_at") @db.Date
  amount Decimal @db.Decimal(14,0)
  paymentMethodId String @map("payment_method_id") @db.Uuid
  registeredById String @map("registered_by_id") @db.Uuid
  operationId String @map("operation_id") @db.Uuid
  adjustmentReason String? @map("adjustment_reason")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  lastModifiedById String? @map("last_modified_by_id") @db.Uuid
  lastModifiedAt DateTime? @map("last_modified_at") @db.Timestamptz(6)
  person Person @relation(fields: [personId], references: [id], onDelete: Restrict)
  paymentMethod PaymentMethod @relation(fields: [paymentMethodId], references: [id], onDelete: Restrict)
  registeredBy InternalUser @relation(fields: [registeredById], references: [id], onDelete: Restrict)
  lastModifiedBy InternalUser? @relation("SalaPaymentModifiedBy", fields: [lastModifiedById], references: [id], onDelete: Restrict)
  @@unique([personId, year, month])
  @@unique([operationId])
  @@index([personId, year, month])
  @@map("sala_payments")
}

model SalaScheduleException {
  id              String                    @id @default(uuid()) @db.Uuid
  scheduleSlotId  String                    @map("schedule_slot_id") @db.Uuid
  date            DateTime                  @db.Date
  type            SalaScheduleExceptionType
  capacityOverride Int?                     @map("capacity_override")
  scheduleSlot    SalaScheduleSlot          @relation(fields: [scheduleSlotId], references: [id], onDelete: Cascade)
  @@unique([scheduleSlotId, date])
  @@map("sala_schedule_exceptions")
}

model PortalCredential {
  personId             String   @id @map("person_id") @db.Uuid
  pinHash              String   @map("pin_hash")
  mustChangePin        Boolean  @default(true) @map("must_change_pin")
  credentialsUpdatedAt DateTime @default(now()) @map("credentials_updated_at") @db.Timestamptz(6)
  person               Person   @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@map("portal_credentials")
}
