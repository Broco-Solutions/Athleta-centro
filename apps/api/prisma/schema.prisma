generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  PROFESSOR
  KINESIOLOGIST
  OSTEOPATH
  ADMINISTRATIVE
  GENERAL_ADMIN
  BROCO_SUPPORT
}

enum InternalUserStatus {
  ACTIVE
  INACTIVE
}

model InternalUser {
  id                             String                     @id @default(uuid()) @db.Uuid
  firstName                      String                     @map("first_name")
  lastName                       String                     @map("last_name")
  email                          String
  normalizedEmail                String                     @unique @map("normalized_email")
  phone                          String?
  dni                            String?
  address                        String?
  birthDate                      DateTime?                  @map("birth_date") @db.Date
  profession                     String?
  athletaStartDate               DateTime?                  @map("athleta_start_date") @db.Date
  status                         InternalUserStatus         @default(ACTIVE)
  createdAt                      DateTime                   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                      DateTime                   @updatedAt @map("updated_at") @db.Timestamptz(6)
  roles                          InternalUserRole[]
  credential                     InternalCredential?
  sessions                       Session[]
  salaParticipations             SalaParticipation[]
  createdSalaOccurrences         SalaOccurrence[]           @relation("SalaOccurrenceCreatedBy")
  modifiedSalaOccurrences        SalaOccurrence[]           @relation("SalaOccurrenceModifiedBy")
  physicalEvaluationsAsProfessor PhysicalEvaluation[]       @relation("PhysicalEvaluationProfessor")
  createdPhysicalEvaluations     PhysicalEvaluation[]       @relation("PhysicalEvaluationCreatedBy")
  salaPaymentsRegistered         SalaPayment[]
  salaPaymentsModified           SalaPayment[]              @relation("SalaPaymentModifiedBy")
  salaChargeAdjustments          SalaChargeAdjustment[]
  salaPaymentReversals           SalaPaymentReversal[]
  clinicalChargeAdjustments      ClinicalChargeAdjustment[]
  clinicalIncomeReversals        ClinicalIncomeReversal[]
  salaChargesCreated             SalaCharge[]               @relation("SalaChargeCreatedBy")
  clinicalChargesCreated         ClinicalCharge[]           @relation("ClinicalChargeCreatedBy")
  expensesRegistered             Expense[]
  clinicalIncomesRegistered      ClinicalIncome[]
  clinicalAppointments           ClinicalAppointment[]      @relation("ClinicalAppointmentProfessional")
  registeredPatients             ClinicalPatient[]
  clinicalAttentions             ClinicalAttention[]
  treatments                     Treatment[]
  evolutionsAuthored             Evolution[]                @relation("EvolutionAuthor")
  evolutionsModified             Evolution[]                @relation("EvolutionModifier")
  evaluationsAuthored            ClinicalEvaluation[]       @relation("EvaluationAuthor")
  evaluationsModified            ClinicalEvaluation[]       @relation("EvaluationModifier")
  fileAssetsCreated              FileAsset[]
  indicationsResponsible         SalaClinicalIndication[]   @relation("IndicationProfessional")
  indicationsClosed              SalaClinicalIndication[]   @relation("IndicationClosedBy")

  @@map("internal_users")
}

model InternalUserRole {
  internalUserId String       @map("internal_user_id") @db.Uuid
  role           Role
  internalUser   InternalUser @relation(fields: [internalUserId], references: [id], onDelete: Restrict)

  @@id([internalUserId, role])
  @@map("internal_user_roles")
}

enum SessionKind {
  INTERNAL
  PORTAL
}

enum SalaWeekday {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum SalaScheduleExceptionType {
  CLOSURE
  CAPACITY_OVERRIDE
}

enum SalaOccurrenceOrigin {
  FIXED
  ONE_OFF
  SPONTANEOUS
}

enum SalaOccurrenceStatus {
  RESERVED
  ATTENDED
  CANCELLED
  ABSENT
}

enum ClinicalAppointmentStatus {
  SCHEDULED
  ATTENDED
  CANCELLED
  ABSENT
}

enum ClinicalCoverage {
  PRIVATE
  SOCIAL_WORK
}

enum ExpenseArea {
  SALA
  CLINIC
  GENERAL
}

enum ClinicalIncomePayer {
  PATIENT
  SOCIAL_WORK
}

enum ClinicalDiscipline {
  KINESIOLOGY
  OSTEOPATHY
}

enum SalaChargeKind {
  MONTHLY
  OPENING_BALANCE
}

enum FinancialAdjustmentKind {
  ADJUSTMENT
  REVERSAL
}

enum ChargeResponsibility {
  PATIENT
  SOCIAL_WORK
}

enum RoutineStatus {
  ACTIVE
  HISTORICAL
}

model InternalCredential {
  internalUserId       String       @id @map("internal_user_id") @db.Uuid
  passwordHash         String       @map("password_hash")
  mustChangePassword   Boolean      @default(true) @map("must_change_password")
  credentialsUpdatedAt DateTime     @default(now()) @map("credentials_updated_at") @db.Timestamptz(6)
  internalUser         InternalUser @relation(fields: [internalUserId], references: [id], onDelete: Cascade)

  @@map("internal_credentials")
}

model Session {
  id             String        @id @default(uuid()) @db.Uuid
  kind           SessionKind
  internalUserId String?       @map("internal_user_id") @db.Uuid
  personId       String?       @map("person_id") @db.Uuid
  secretHash     String        @unique @map("secret_hash")
  csrfToken      String        @map("csrf_token")
  expiresAt      DateTime      @map("expires_at") @db.Timestamptz(6)
  lastActivityAt DateTime      @default(now()) @map("last_activity_at") @db.Timestamptz(6)
  revokedAt      DateTime?     @map("revoked_at") @db.Timestamptz(6)
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  internalUser   InternalUser? @relation(fields: [internalUserId], references: [id], onDelete: Cascade)
  person         Person?       @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@index([internalUserId])
  @@index([personId])
  @@index([expiresAt])
  @@index([revokedAt])
  @@map("sessions")
}

model AuthAttemptBucket {
  key             String    @id
  failureCount    Int       @default(0) @map("failure_count")
  windowStartedAt DateTime  @map("window_started_at") @db.Timestamptz(6)
  lockedUntil     DateTime? @map("locked_until") @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("auth_attempt_buckets")
}

model Person {
  id                      String                   @id @default(uuid()) @db.Uuid
  firstName               String                   @map("first_name")
  lastName                String                   @map("last_name")
  dni                     String
  normalizedDni           String                   @unique @map("normalized_dni")
  phone                   String
  birthDate               DateTime                 @map("birth_date") @db.Date
  email                   String?
  normalizedEmail         String?                  @map("normalized_email")
  emergencyContactName    String?                  @map("emergency_contact_name")
  emergencyContactPhone   String?                  @map("emergency_contact_phone")
  socialWorkId            String?                  @map("social_work_id") @db.Uuid
  affiliateNumber         String?                  @map("affiliate_number")
  createdAt               DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(6)
  portalCredential        PortalCredential?
  portalSessions          Session[]
  salaParticipations      SalaParticipation[]
  fixedBookings           FixedSalaBooking[]
  reservations            OneOffReservation[]
  salaOccurrences         SalaOccurrence[]
  routines                Routine[]
  physicalEvaluations     PhysicalEvaluation[]
  salaPayments            SalaPayment[]
  salaCharges             SalaCharge[]
  clinicalIncomes         ClinicalIncome[]
  clinicalCharges         ClinicalCharge[]
  clinicalPatient         ClinicalPatient?
  clinicalAppointments    ClinicalAppointment[]
  clinicalAttentions      ClinicalAttention[]
  treatments              Treatment[]
  clinicalStudies         ClinicalStudy[]
  socialWork              SocialWork?              @relation(fields: [socialWorkId], references: [id], onDelete: Restrict)
  socialWorkOrders        SocialWorkOrder[]
  salaClinicalIndications SalaClinicalIndication[]

  @@index([lastName, firstName])
  @@index([normalizedEmail])
  @@map("people")
}

model ClinicalPatient {
  personId       String       @id @map("person_id") @db.Uuid
  registeredById String       @map("registered_by_id") @db.Uuid
  registeredAt   DateTime     @default(now()) @map("registered_at") @db.Timestamptz(6)
  person         Person       @relation(fields: [personId], references: [id], onDelete: Restrict)
  registeredBy   InternalUser @relation(fields: [registeredById], references: [id], onDelete: Restrict)

  @@map("clinical_patients")
}

model ClinicalAppointment {
  id              String                    @id @default(uuid()) @db.Uuid
  personId        String                    @map("person_id") @db.Uuid
  professionalId  String                    @map("professional_id") @db.Uuid
  serviceId       String?                   @map("service_id") @db.Uuid
  startAt         DateTime                  @map("start_at") @db.Timestamptz(6)
  durationMinutes Int                       @default(60) @map("duration_minutes")
  status          ClinicalAppointmentStatus @default(SCHEDULED)
  operationalNote String?                   @map("operational_note")
  createdAt       DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime                  @updatedAt @map("updated_at") @db.Timestamptz(6)
  person          Person                    @relation(fields: [personId], references: [id], onDelete: Restrict)
  professional    InternalUser              @relation("ClinicalAppointmentProfessional", fields: [professionalId], references: [id], onDelete: Restrict)
  service         ClinicalService?          @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  attention       ClinicalAttention?

  @@index([personId, startAt])
  @@index([professionalId, startAt])
  @@index([serviceId])
  @@index([status, startAt])
  @@map("clinical_appointments")
}

model ClinicalAttention {
  id              String               @id @default(uuid()) @db.Uuid
  appointmentId   String?              @unique @map("appointment_id") @db.Uuid
  personId        String               @map("person_id") @db.Uuid
  professionalId  String               @map("professional_id") @db.Uuid
  serviceId       String?              @map("service_id") @db.Uuid
  occurredAt      DateTime             @map("occurred_at") @db.Timestamptz(6)
  coverage        ClinicalCoverage?
  createdAt       DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  appointment     ClinicalAppointment? @relation(fields: [appointmentId], references: [id], onDelete: Restrict)
  person          Person               @relation(fields: [personId], references: [id], onDelete: Restrict)
  professional    InternalUser         @relation(fields: [professionalId], references: [id], onDelete: Restrict)
  service         ClinicalService?     @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  treatmentId     String?              @map("treatment_id") @db.Uuid
  treatment       Treatment?           @relation(fields: [treatmentId], references: [id], onDelete: Restrict)
  evolution       Evolution?
  evaluations     ClinicalEvaluation[]
  clinicalIncomes ClinicalIncome[]
  charge          ClinicalCharge?

  @@map("clinical_attentions")
}

model ClinicalService {
  id              String                @id @default(uuid()) @db.Uuid
  name            String                @db.VarChar(120)
  normalizedName  String                @unique @map("normalized_name") @db.VarChar(120)
  discipline      ClinicalDiscipline?
  durationMinutes Int                   @map("duration_minutes")
  feeArs          Decimal               @map("fee_ars") @db.Decimal(14, 0)
  isAvailable     Boolean               @default(true) @map("is_available")
  createdAt       DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)
  appointments    ClinicalAppointment[]
  attentions      ClinicalAttention[]
  charges         ClinicalCharge[]

  @@map("clinical_services")
}

enum ClinicalTestResponseType {
  CATEGORICAL
  NUMERIC
  SCALE
  OPTIONS
  TEXT
}

enum SalaClinicalIndicationStatus {
  ACTIVE
  CLOSED
}

enum TrainingCondition {
  NO_RESTRICTIONS
  RESTRICTED
  DO_NOT_TRAIN
}

model ClinicalProtocol {
  id             String               @id @default(uuid()) @db.Uuid
  name           String
  normalizedName String               @unique @map("normalized_name")
  isActive       Boolean              @default(true) @map("is_active")
  createdAt      DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  evaluations    ClinicalEvaluation[]

  @@map("clinical_protocols")
}

model ClinicalTestDefinition {
  id             String                   @id @default(uuid()) @db.Uuid
  name           String
  normalizedName String                   @unique @map("normalized_name")
  responseType   ClinicalTestResponseType @map("response_type")
  scaleMin       Decimal?                 @map("scale_min") @db.Decimal(14, 4)
  scaleMax       Decimal?                 @map("scale_max") @db.Decimal(14, 4)
  unit           String?
  options        Json?
  isSelectable   Boolean                  @default(true) @map("is_selectable")
  createdAt      DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  results        ClinicalTestResult[]

  @@map("clinical_test_definitions")
}

model MeasurementMethod {
  id             String               @id @default(uuid()) @db.Uuid
  name           String
  normalizedName String               @unique @map("normalized_name")
  description    String?
  isSelectable   Boolean              @default(true) @map("is_selectable")
  createdAt      DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  results        ClinicalTestResult[]

  @@map("measurement_methods")
}

model ClinicalEvaluation {
  id               String               @id @default(uuid()) @db.Uuid
  attentionId      String               @map("attention_id") @db.Uuid
  protocolId       String?              @map("protocol_id") @db.Uuid
  bodyAreaOrType   String               @map("body_area_or_type")
  conclusion       String?
  authorId         String               @map("author_id") @db.Uuid
  createdAt        DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  lastModifiedById String?              @map("last_modified_by_id") @db.Uuid
  lastModifiedAt   DateTime?            @map("last_modified_at") @db.Timestamptz(6)
  attention        ClinicalAttention    @relation(fields: [attentionId], references: [id], onDelete: Restrict)
  protocol         ClinicalProtocol?    @relation(fields: [protocolId], references: [id], onDelete: Restrict)
  author           InternalUser         @relation("EvaluationAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  lastModifiedBy   InternalUser?        @relation("EvaluationModifier", fields: [lastModifiedById], references: [id], onDelete: Restrict)
  results          ClinicalTestResult[]

  @@index([attentionId])
  @@map("clinical_evaluations")
}

model ClinicalTestResult {
  id                  String                 @id @default(uuid()) @db.Uuid
  evaluationId        String                 @map("evaluation_id") @db.Uuid
  testDefinitionId    String                 @map("test_definition_id") @db.Uuid
  measurementMethodId String?                @map("measurement_method_id") @db.Uuid
  side                String?
  observation         String?
  value               Json
  definitionSnapshot  Json                   @map("definition_snapshot")
  evaluation          ClinicalEvaluation     @relation(fields: [evaluationId], references: [id], onDelete: Restrict)
  testDefinition      ClinicalTestDefinition @relation(fields: [testDefinitionId], references: [id], onDelete: Restrict)
  measurementMethod   MeasurementMethod?     @relation(fields: [measurementMethodId], references: [id], onDelete: Restrict)

  @@index([evaluationId])
  @@map("clinical_test_results")
}

model Evolution {
  id                     String            @id @default(uuid()) @db.Uuid
  attentionId            String            @unique @map("attention_id") @db.Uuid
  evolutionText          String?           @map("evolution_text")
  practicesOrManeuvers   String?           @map("practices_or_maneuvers")
  indicationsOrNextSteps String?           @map("indications_or_next_steps")
  authorId               String            @map("author_id") @db.Uuid
  createdAt              DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  lastModifiedById       String?           @map("last_modified_by_id") @db.Uuid
  lastModifiedAt         DateTime?         @map("last_modified_at") @db.Timestamptz(6)
  attention              ClinicalAttention @relation(fields: [attentionId], references: [id], onDelete: Restrict)
  author                 InternalUser      @relation("EvolutionAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  lastModifiedBy         InternalUser?     @relation("EvolutionModifier", fields: [lastModifiedById], references: [id], onDelete: Restrict)

  @@map("clinical_evolutions")
}

enum TreatmentStatus {
  IN_PROGRESS
  FINISHED
}

enum TreatmentFinishReason {
  DISCHARGE
  INTERRUPTION
  REFERRAL
  OTHER
}

model Treatment {
  id                        String                   @id @default(uuid()) @db.Uuid
  personId                  String                   @map("person_id") @db.Uuid
  responsibleProfessionalId String                   @map("responsible_professional_id") @db.Uuid
  consultationReason        String                   @map("consultation_reason")
  bodyAreaOrInjury          String                   @map("body_area_or_injury")
  objective                 String?
  interventionPlan          String?
  currentStage              String?                  @map("current_stage")
  startDate                 DateTime                 @map("start_date") @db.Date
  status                    TreatmentStatus          @default(IN_PROGRESS)
  finishDate                DateTime?                @map("finish_date") @db.Date
  finishReason              TreatmentFinishReason?   @map("finish_reason")
  conclusion                String?
  createdAt                 DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                 DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(6)
  person                    Person                   @relation(fields: [personId], references: [id], onDelete: Restrict)
  responsibleProfessional   InternalUser             @relation(fields: [responsibleProfessionalId], references: [id], onDelete: Restrict)
  attentions                ClinicalAttention[]
  studies                   ClinicalStudy[]
  salaClinicalIndications   SalaClinicalIndication[]

  @@index([personId, status])
  @@index([responsibleProfessionalId, status])
  @@map("treatments")
}

model ClinicalStudy {
  id          String     @id @default(uuid()) @db.Uuid
  personId    String     @map("person_id") @db.Uuid
  treatmentId String?    @map("treatment_id") @db.Uuid
  studyDate   DateTime   @map("study_date") @db.Date
  studyType   String     @map("study_type")
  description String?
  fileAssetId String?    @unique @map("file_asset_id") @db.Uuid
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  person      Person     @relation(fields: [personId], references: [id], onDelete: Restrict)
  treatment   Treatment? @relation(fields: [treatmentId], references: [id], onDelete: Restrict)
  fileAsset   FileAsset? @relation(fields: [fileAssetId], references: [id], onDelete: Restrict)

  @@index([personId, studyDate])
  @@map("clinical_studies")
}

model FileAsset {
  id              String           @id @default(uuid()) @db.Uuid
  storageKey      String           @unique @map("storage_key")
  originalName    String           @map("original_name")
  mimeType        String           @map("mime_type")
  size            Int
  checksum        String
  createdById     String           @map("created_by_id") @db.Uuid
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy       InternalUser     @relation(fields: [createdById], references: [id], onDelete: Restrict)
  clinicalStudy   ClinicalStudy?
  socialWorkOrder SocialWorkOrder?

  @@map("file_assets")
}

model SocialWork {
  id              String            @id @default(uuid()) @db.Uuid
  name            String
  normalizedName  String            @unique @map("normalized_name")
  isSelectable    Boolean           @default(true) @map("is_selectable")
  createdAt       DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  people          Person[]
  orders          SocialWorkOrder[]
  clinicalIncomes ClinicalIncome[]
  clinicalCharges ClinicalCharge[]

  @@map("social_works")
}

model SocialWorkOrder {
  id              String           @id @default(uuid()) @db.Uuid
  personId        String           @map("person_id") @db.Uuid
  socialWorkId    String           @map("social_work_id") @db.Uuid
  reference       String
  issueDate       DateTime?        @map("issue_date") @db.Date
  expirationDate  DateTime?        @map("expiration_date") @db.Date
  fileAssetId     String?          @unique @map("file_asset_id") @db.Uuid
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  person          Person           @relation(fields: [personId], references: [id], onDelete: Restrict)
  socialWork      SocialWork       @relation(fields: [socialWorkId], references: [id], onDelete: Restrict)
  fileAsset       FileAsset?       @relation(fields: [fileAssetId], references: [id], onDelete: Restrict)
  clinicalIncomes ClinicalIncome[]
  clinicalCharges ClinicalCharge[]

  @@index([personId, expirationDate])
  @@map("social_work_orders")
}

model SalaClinicalIndication {
  id                        String                       @id @default(uuid()) @db.Uuid
  personId                  String                       @map("person_id") @db.Uuid
  treatmentId               String?                      @map("treatment_id") @db.Uuid
  responsibleProfessionalId String                       @map("responsible_professional_id") @db.Uuid
  trainingCondition         TrainingCondition            @map("training_condition")
  affectedArea              String?                      @map("affected_area")
  instructions              String?
  status                    SalaClinicalIndicationStatus @default(ACTIVE)
  createdAt                 DateTime                     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                 DateTime                     @updatedAt @map("updated_at") @db.Timestamptz(6)
  closedAt                  DateTime?                    @map("closed_at") @db.Timestamptz(6)
  closedById                String?                      @map("closed_by_id") @db.Uuid
  person                    Person                       @relation(fields: [personId], references: [id], onDelete: Restrict)
  treatment                 Treatment?                   @relation(fields: [treatmentId], references: [id], onDelete: Restrict)
  responsibleProfessional   InternalUser                 @relation("IndicationProfessional", fields: [responsibleProfessionalId], references: [id], onDelete: Restrict)
  closedBy                  InternalUser?                @relation("IndicationClosedBy", fields: [closedById], references: [id], onDelete: Restrict)

  @@index([personId, status])
  @@map("sala_clinical_indications")
}

model SalaConfiguration {
  id              String   @id @default("default")
  generalCapacity Int      @map("general_capacity")
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("sala_configuration")
}

model SalaPlan {
  id             String               @id @default(uuid()) @db.Uuid
  name           String
  monthlyAmount  Decimal              @map("monthly_amount") @db.Decimal(14, 0)
  isSelectable   Boolean              @default(true) @map("is_selectable")
  createdAt      DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)
  participations SalaParticipation[]
  assignments    SalaPlanAssignment[]
  charges        SalaCharge[]

  @@map("sala_plans")
}

model SalaParticipation {
  id                  String               @id @default(uuid()) @db.Uuid
  personId            String               @map("person_id") @db.Uuid
  mainProfessorId     String               @map("main_professor_id") @db.Uuid
  planId              String               @map("plan_id") @db.Uuid
  startDate           DateTime             @map("start_date") @db.Date
  endDate             DateTime?            @map("end_date") @db.Date
  createdAt           DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)
  person              Person               @relation(fields: [personId], references: [id], onDelete: Restrict)
  mainProfessor       InternalUser         @relation(fields: [mainProfessorId], references: [id], onDelete: Restrict)
  plan                SalaPlan             @relation(fields: [planId], references: [id], onDelete: Restrict)
  fixedBookings       FixedSalaBooking[]
  reservations        OneOffReservation[]
  routines            Routine[]
  physicalEvaluations PhysicalEvaluation[]
  planAssignments     SalaPlanAssignment[]
  charges             SalaCharge[]

  @@index([personId])
  @@index([mainProfessorId])
  @@index([planId])
  @@map("sala_participations")
}

model SalaPlanAssignment {
  id                  String            @id @default(uuid()) @db.Uuid
  salaParticipationId String            @map("sala_participation_id") @db.Uuid
  planId              String            @map("plan_id") @db.Uuid
  effectiveFrom       DateTime          @map("effective_from") @db.Date
  createdAt           DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  salaParticipation   SalaParticipation @relation(fields: [salaParticipationId], references: [id], onDelete: Cascade)
  plan                SalaPlan          @relation(fields: [planId], references: [id], onDelete: Restrict)

  @@unique([salaParticipationId, effectiveFrom])
  @@index([planId])
  @@map("sala_plan_assignments")
}

model SalaServiceType {
  id              String              @id @default(uuid()) @db.Uuid
  name            String              @db.VarChar(120)
  normalizedName  String              @unique @map("normalized_name") @db.VarChar(120)
  durationMinutes Int                 @map("duration_minutes")
  isSelectable    Boolean             @default(true) @map("is_selectable")
  createdAt       DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)
  fixedBookings   FixedSalaBooking[]
  reservations    OneOffReservation[]

  @@map("sala_service_types")
}

model ExerciseDefinition {
  id               String            @id @default(uuid()) @db.Uuid
  name             String            @db.VarChar(120)
  primaryMuscle    String            @map("primary_muscle") @db.VarChar(120)
